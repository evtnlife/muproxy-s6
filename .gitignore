# =============================================================
# BlackRockMU — o que é versionado:
#
#   - código-fonte do projeto (byp/, openspec/, Scripts/, …)
#   - os arquivos da RAIZ do repo, que também são a pasta do jogo:
#     byp.dll, opengl32.dll, MuProxy2.* e wzAudio.dll (§ "Deployáveis")
#
# O que NÃO é versionado (fica só no disco):
#   - assets e binários do CLIENTE do jogo (Data/, main.exe, Main.dll, …)
#   - fontes de referência de terceiros (MuEmu-master, OpenMU-master)
# =============================================================

# --- Build / artefatos de compilação -----------------------------------
*.sdf
*.obj
*.exp
*.lib
*.pdb
*.map
*.log
dist/
build/
.vs/*
*/obj/*
*/bin/
*/Debug/
*/Release/
MuProxy2.Hook/MuProxy2.Hook/Release/MuProxy2.Hook.dll.recipe
MuProxy2.Hook/MuProxy2.Hook/Release/MuProxy2.Hook.tlog/CL.command.1.tlog
MuProxy2.Hook/MuProxy2.Hook/Release/MuProxy2.Hook.tlog/Cl.items.tlog
MuProxy2.Hook/MuProxy2.Hook/Release/MuProxy2.Hook.tlog/CL.read.1.tlog
MuProxy2.Hook/MuProxy2.Hook/Release/MuProxy2.Hook.tlog/CL.write.1.tlog
MuProxy2.Hook/MuProxy2.Hook/Release/MuProxy2.Hook.tlog/link.command.1.tlog
MuProxy2.Hook/MuProxy2.Hook/Release/MuProxy2.Hook.tlog/link.read.1.tlog
MuProxy2.Hook/MuProxy2.Hook/Release/MuProxy2.Hook.tlog/link.secondary.1.tlog
MuProxy2.Hook/MuProxy2.Hook/Release/MuProxy2.Hook.tlog/link.write.1.tlog
MuProxy2.Hook/MuProxy2.Hook/Release/MuProxy2.Hook.tlog/MuProxy2.Hook.lastbuildstate

# --- Binários do cliente do jogo ----------------------------------------
*.dll
*.exe
config.EMU
Settings.ini
main.premium

# --- Arquivos da raiz que ficam versionados ------------------------------
# A raiz do repo É a pasta do jogo (F:\blackrockmu). Estes arquivos são
# gerados pelo build (ou são o módulo do PS) e precisam ficar versionados
# para o repo já entregar o jogo pronto para rodar.
!byp.dll
!opengl32.dll
!MuProxy2.exe
!MuProxy2.dll
!MuProxy2.deps.json
!MuProxy2.runtimeconfig.json
!wzAudio.dll

# --- Assets do jogo ------------------------------------------------------
/Data/

# --- Assets do launcher (WebView2) ---------------------------------------
/BlackrockMU.exe.WebView2/

# --- Fontes de referência de terceiros (somente leitura) ----------------
/MuEmu-master/
/OpenMU-master/

# --- Ambiente local ------------------------------------------------------
.novamind/
node_modules/
sessions/
