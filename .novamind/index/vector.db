o:** Fecha o jogo, copia a DLL nova, abre de novo. Aí vai aparecer a linha: ``` [SKILLHOOK] TABLE: flag=? index=0x003C base=0x???? wireId=???? ``` Isso responde definitivamente se 0xE7C3 vem da tabela ou não.\n- **Tools:** none","vector":[0.005365026,0.014072696,-0.14196369,-0.07292395,0.06592717,-0.10982428,0.043079186,0.018143378,-0.06792385,-0.055091064,-0.12058252,0.03974557,0.06468123,-0.048070673,0.011797407,-0.04663258,-0.041561097,-0.09305613,-0.044398773,0.0006028769,0.03951053,-0.023419464,-0.01140832,-0.056854375,0.07317369,0.028704084,0.0062444736,0.0132678235,-0.06460763,-0.017479023,0.053967517,-0.041191112,-0.012465813,-0.053296562,-0.010470491,-0.025044296,-0.0011919335,-0.053261045,-0.041749023,0.033710066,-0.011070221,-0.038069602,0.014320081,-0.015247805,-0.008796223,0.032690804,0.045722328,0.04926956,0.044802383,-0.07103138,-0.00067184534,-0.009196815,-0.027238801,-0.034519136,0.09077144,0.006613267,-0.09027643,0.026735624,0.007067575,-0.03228428,0.09867968,0.021116653,-0.0042208103,0.062740564,0.02042677,0.03216861,-0.036879607,0.07877673,-0.055003785,-0.008818659,0.042668264,-0.03531872,-0.011115644,0.01268703,-0.010221455,0.0087067755,-0.04802861,-0.036830064,-0.0041976916,-0.014954811,-0.012198404,0.01143905,0.05263956,-0.052481037,0.01232105,0.008520037,-0.033664286,0.029988104,-0.03511202,0.08014919,-0.010965996,0.008918109,0.0352518,-0.015121555,-0.04070665,0.023122452,-0.038860988,0.032788973,-0.0029642934,-0.030785332,-0.005862811,-0.0074599124,0.025743088,-0.027644353,0.010505171,0.07562413,0.014364847,0.012824151,0.013472415,0.0046417653,-0.010608488,0.012482963,-0.016899996,-0.055913884,0.06171997,-0.0075096344,0.04483458,-0.032579444,-0.0023972346,0.05061349,-0.04254352,-0.0069549554,0.008833101,0.067143165,0.07594848,-0.016272658,-0.00089382846,0.0494853,0.03681133,-0.0765113,-0.0074771647,-0.004199267,-0.09312772,0.027203394,0.048196837,0.008248144,0.006567287,-0.025156919,0.048544582,0.011085661,0.020357948,0.004329296,0.014030274